# ── Base de données ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kitchenpulse_db
DB_USER=root
DB_PASSWORD=

# Alias URI (optionnel, conservé pour compatibilité outils tiers)
DATABASE_URL="mysql://root:@localhost:3306/kitchenpulse_db"

# ── Serveur ────────────────────────────────────────────────────
PORT=3001

# ── Authentification ───────────────────────────────────────────
JWT_SECRET=kitchenpulse_secret

# ── CORS / Socket.io ───────────────────────────────────────────
SOCKET_CORS_ORIGIN=*